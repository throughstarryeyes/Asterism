# Google Drive sync is off in a build unless this is set.
# Make a project at console.cloud.google.com, enable the Drive API, and create an OAuth client (Web application).
# Add your site (and http://localhost:5173 for development) as an authorized JavaScript origin.
# The only scope used is drive.appdata, the app's own hidden folder.
VITE_GOOGLE_CLIENT_ID=

# The Windows app signs in with a second client from the same project, of type "Desktop app".
# Google gives it a secret; for installed apps Google does not treat it as private, so it may go in the build.
VITE_GOOGLE_DESKTOP_CLIENT_ID=
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=
